# 部署到 Zeabur 时不上传的文件/目录
# (zeabur deploy 会读取此文件)

# 复用 .gitignore 排除的常规内容
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# 虚拟环境
venv/
ENV/
env/
.venv/

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# 环境变量
.env
.env.local

# 训练产物 / 大数据集（已在 Zeabur 持久卷中）
backend/data/
backend/checkpoints/
backend/uploads/
outputs/
checkpoints/
*.pkl
*.pt
*.pth
*.ckpt

# 日志
*.log
logs/

# Git/CI
.git/
.github/

# 项目文档/截图（不影响线上）
屏幕截图*.png
*.md.bak

# Codex/Cursor 元数据
.codex/
.cursor/
